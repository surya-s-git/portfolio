%% ==========================================================
%% 7️⃣ CREATE CUSTOM OPTIMUS-LIKE HUMANOID (STATIC)
%% ==========================================================

disp('Creating Custom Optimus-like Humanoid Robot...');

optimus = rigidBodyTree('DataFormat','row','Gravity',[0 0 -9.81]);

function addLimb(tree,parent,bodyName,jointName,jointType,jointAxis,transform,meshType,meshDims)
    body = rigidBody(bodyName);
    joint = rigidBodyJoint(jointName,jointType);
    joint.JointAxis = jointAxis;
    setFixedTransform(joint,transform);
    body.Joint = joint;
    
    if strcmp(meshType,'box')
        addCollision(body,'box',meshDims);
    elseif strcmp(meshType,'cylinder')
        addCollision(body,'cylinder',meshDims);
    end
    
    addBody(tree,body,parent);
end

% Torso
torso = rigidBody('torso');
addCollision(torso,'box',[0.3 0.2 0.5]);
addBody(optimus,torso,'base');

% Head
addLimb(optimus,'torso','neck','neck_joint','revolute',[0 0 1],trvec2tform([0 0 0.5]),'cylinder',[0.1 0.1]);
addLimb(optimus,'neck','head','head_joint','revolute',[1 0 0],trvec2tform([0 0 0.1]),'box',[0.2 0.2 0.2]);

% Left Arm
addLimb(optimus,'torso','l_shoulder','l_shoulder_joint','revolute',[1 0 0],trvec2tform([0.2 0 0.4]),'cylinder',[0.05 0.3]);
addLimb(optimus,'l_shoulder','l_elbow','l_elbow_joint','revolute',[1 0 0],trvec2tform([0 0 -0.3]),'cylinder',[0.05 0.25]);
addLimb(optimus,'l_elbow','l_wrist','l_wrist_joint','revolute',[0 1 0],trvec2tform([0 0 -0.25]),'box',[0.1 0.1 0.05]);

% Right Arm
addLimb(optimus,'torso','r_shoulder','r_shoulder_joint','revolute',[1 0 0],trvec2tform([-0.2 0 0.4]),'cylinder',[0.05 0.3]);
addLimb(optimus,'r_shoulder','r_elbow','r_elbow_joint','revolute',[1 0 0],trvec2tform([0 0 -0.3]),'cylinder',[0.05 0.25]);
addLimb(optimus,'r_elbow','r_wrist','r_wrist_joint','revolute',[0 1 0],trvec2tform([0 0 -0.25]),'box',[0.1 0.1 0.05]);

% Left Leg
addLimb(optimus,'torso','l_hip','l_hip_joint','revolute',[1 0 0],trvec2tform([0.1 0 -0.3]),'cylinder',[0.08 0.4]);
addLimb(optimus,'l_hip','l_knee','l_knee_joint','revolute',[1 0 0],trvec2tform([0 0 -0.4]),'cylinder',[0.08 0.35]);
addLimb(optimus,'l_knee','l_ankle','l_ankle_joint','revolute',[0 1 0],trvec2tform([0 0 -0.35]),'box',[0.15 0.1 0.05]);

% Right Leg
addLimb(optimus,'torso','r_hip','r_hip_joint','revolute',[1 0 0],trvec2tform([-0.1 0 -0.3]),'cylinder',[0.08 0.4]);
addLimb(optimus,'r_hip','r_knee','r_knee_joint','revolute',[1 0 0],trvec2tform([0 0 -0.4]),'cylinder',[0.08 0.35]);
addLimb(optimus,'r_knee','r_ankle','r_ankle_joint','revolute',[0 1 0],trvec2tform([0 0 -0.35]),'box',[0.15 0.1 0.05]);

disp('Custom Optimus-like Humanoid Created.');

