%% ==========================================================
%% 2️⃣ DISPLAY JOINT TYPES
%% ==========================================================

function showJointTypes(robot, robotName)
    fprintf('\nJoint Types in %s:\n', robotName);
    for i = 1:length(robot.Bodies)
        joint = robot.Bodies{i}.Joint;
        fprintf('Body: %-25s Joint Type: %s\n', ...
            robot.Bodies{i}.Name, joint.Type);
    end
end

showJointTypes(ur10, "UR10");
showJointTypes(kinova, "Kinova Gen3");
showJointTypes(atlas, "Atlas Humanoid");

